{
  "name": "tsops",
  "version": "2.1.0",
  "description": "Typed application delivery for TypeScript monorepos on Kubernetes",
  "type": "module",
  "bin": {
    "tsops": "./bin/tsops.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b .",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "lint": "pnpm -w exec biome check packages/cli",
    "prepare": "tsc -b ."
  },
  "dependencies": {
    "@tsops/core": "workspace:*",
    "@tsops/node": "workspace:*",
    "commander": "^14.0.3"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "typescript",
    "monorepo",
    "application-delivery",
    "preview-environments",
    "local-development",
    "docker",
    "ci-cd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pom4H/tsops.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Pom4H/tsops#readme",
  "bugs": {
    "url": "https://github.com/Pom4H/tsops/issues"
  },
  "license": "MIT",
  "author": "Roman Popov",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
