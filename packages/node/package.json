{
  "name": "@tsops/node",
  "version": "2.1.0",
  "description": "Node.js adapters for tsops Git, Docker, kubectl, and process operations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b .",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "lint": "pnpm -w exec biome check packages/node"
  },
  "dependencies": {
    "@tsops/core": "workspace:*",
    "globby": "^11.1.0",
    "ignore": "^5.3.2"
  },
  "keywords": [
    "tsops",
    "node",
    "kubernetes",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pom4H/tsops.git",
    "directory": "packages/node"
  },
  "license": "MIT",
  "author": "Roman Popov",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
